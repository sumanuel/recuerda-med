{
  "expo": {
    "name": "RecuerdaMed",
    "slug": "recuerda-med",
    "scheme": "recuerdamed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.nexoit.recuerdamed",
      "infoPlist": {
        "NSCameraUsageDescription": "Para tomar la foto del medicamento.",
        "NSPhotoLibraryUsageDescription": "Para elegir la foto del medicamento."
      }
    },
    "android": {
      "package": "cl.nexoit.recuerdamed",
      "adaptiveIcon": {
        "backgroundColor": "#0B5FB0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#0B5FB0",
          "sounds": [
            "./assets/alarm.wav",
            "./assets/alarm-long.wav"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para elegir la foto del medicamento.",
          "cameraPermission": "Para tomar la foto del medicamento."
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-sharing",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "Esto permite mostrarte anuncios más relevantes."
        }
      ],
      "./plugins/with-no-workmanager-init.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 64,
          "backgroundColor": "#0B5FB0",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0B2F57"
          }
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1e68b9a4-88f1-4da3-835c-39c12681f512"
      }
    }
  }
}
